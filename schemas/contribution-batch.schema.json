{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UPI contribution batch",
  "type": "object",
  "required": ["format", "version", "verification_type", "claims_experimental_verification", "records"],
  "properties": {
    "format": {"const": "upi-contribution-batch"},
    "version": {"type": "string", "minLength": 1},
    "verification_type": {"const": "software_test"},
    "claims_experimental_verification": {"const": false},
    "producer": {"type": "string"},
    "model": {"type": "string"},
    "source": {"type": "string"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["record_type", "payload"],
        "properties": {
          "record_type": {"type": "string", "enum": ["node", "bridge"]},
          "payload": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
