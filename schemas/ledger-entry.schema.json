{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UPI Workflow Ledger Entry",
  "type": "object",
  "required": [
    "entry_id",
    "task_id",
    "workflow_id",
    "owner",
    "state",
    "artifact",
    "evidence",
    "decision",
    "deadline_at",
    "verification_type",
    "status"
  ],
  "properties": {
    "entry_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "state": {
      "type": "string",
      "enum": ["QUEUED", "LEASED", "RUNNING", "SUCCEEDED", "FAILED", "TIMED_OUT", "QUARANTINED", "CANCELLED"]
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"type": "string", "enum": ["report", "diff", "log", "schema", "other"]},
        "ref": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"type": "string", "enum": ["log", "screenshot", "diff", "video", "test", "hash"]},
          "ref": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "decision": {"type": "string", "enum": ["advance", "retry", "escalate"]},
    "deadline_at": {"type": "string", "format": "date-time"},
    "next_owner": {"type": "string", "minLength": 1},
    "verification_type": {"const": "software_test"},
    "status": {"type": "string", "enum": ["EST", "DER", "HYP", "STOP", "ERR", "SYM"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
