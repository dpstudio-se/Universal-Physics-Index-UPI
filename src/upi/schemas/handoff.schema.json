{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UPI Typed Workflow Handoff",
  "type": "object",
  "required": [
    "handoff_id",
    "task_id",
    "from_owner",
    "next_owner",
    "artifact",
    "evidence",
    "assumptions",
    "risks",
    "deadline_at",
    "status"
  ],
  "properties": {
    "handoff_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "from_owner": {"type": "string", "minLength": 1},
    "next_owner": {"type": "string", "minLength": 1},
    "artifact": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"type": "string", "enum": ["report", "diff", "log", "schema", "other"]},
        "ref": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"type": "string", "enum": ["log", "screenshot", "diff", "video", "test", "hash"]},
          "ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "deadline_at": {"type": "string", "format": "date-time"},
    "status": {"const": "SYM"},
    "confusion_guard": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
