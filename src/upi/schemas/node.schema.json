{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UPI Physics Node Schema",
  "description": "Schema for UPI physics and mathematics nodes with status tracking",
  "type": "object",
  "required": [
    "address",
    "title",
    "description",
    "status"
  ],
  "properties": {
    "address": {
      "type": "string",
      "pattern": "^UPI<[^,]+,[0-9]+,[^,]+,[^,>]+>$",
      "description": "UPI address: UPI<Domain,Generation,Torus,Node>"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Concept title"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Detailed description"
    },
    "status": {
      "type": "string",
      "enum": ["EST", "DER", "HYP", "STOP", "ERR", "SYM"],
      "description": "Scientific status: EST=established, DER=derived, HYP=hypothesis, STOP=missing, ERR=error, SYM=symbolic"
    },
    "quantities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "unit"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number",
            "not": {"const": null}
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "uncertainty": {
            "type": "number"
          },
          "reference": {
            "type": "string"
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "equations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "mechanism": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "source"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["experiment", "observation", "calculation", "simulation", "other"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "primary_sources": {
      "type": "array",
      "items": {"type": "string"}
    },
    "predictions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "falsification_conditions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "information_layer": {
      "type": "string",
      "enum": ["PRIVATE", "PUBLIC", "ACADEMIC"],
      "description": "Disclosure/formality context, not evidence strength"
    },
    "reference_frame": {"type": "string"},
    "normalization_method": {"type": "string"},
    "normalization_claim": {"type": "string"},
    "null_model": {"type": "string"},
    "control_condition": {"type": "string"},
    "statistical_method": {"type": "string"},
    "confounders": {"type": "array", "items": {"type": "string"}},
    "replication_rule": {"type": "string"},
    "linked_robustness_evidence": {
      "type": "object",
      "required": ["sample_size", "failure_count", "independence_documented", "criterion_predeclared", "tested_domain", "test_links"],
      "properties": {
        "sample_size": {"type": "integer", "minimum": 1},
        "failure_count": {"type": "integer", "minimum": 0},
        "independence_documented": {"type": "boolean"},
        "criterion_predeclared": {"type": "boolean"},
        "tested_domain": {"type": "string", "minLength": 1},
        "test_links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_record", "target_record", "relation", "test_source", "tested_claim"],
            "properties": {
              "source_record": {"type": "string", "minLength": 1},
              "target_record": {"type": "string", "minLength": 1},
              "relation": {"enum": ["MEASURED_BY", "SUPPORTED_BY", "REPLICATED_BY"]},
              "test_source": {"type": "string", "minLength": 1},
              "tested_claim": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "causal_claim": {"type": "boolean"},
    "causal_test_method": {"type": "string"},
    "verification_type": {
      "type": "string",
      "enum": ["software_test", "simulation", "mathematical_check", "experimental_observation", "replication", "none"]
    },
    "claims_experimental_verification": {"type": "boolean"},
    "confusion_guard": {
      "type": "string",
      "description": "Warning about common misinterpretations"
    },
    "stop_reason": {
      "type": "string",
      "description": "Required if status='STOP': what is missing or unresolved"
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "version": {
      "type": "string",
      "default": "0.1.0"
    },
    "replaces": {
      "type": "string",
      "pattern": "^UPI<[^,]+,[0-9]+,[^,]+,[^,>]+>$"
    },
    "superseded_by": {
      "type": "string",
      "pattern": "^UPI<[^,]+,[0-9]+,[^,]+,[^,>]+>$"
    },
    "source_status": {
      "type": "string",
      "enum": [
        "peer_reviewed",
        "preprint",
        "dataset",
        "textbook",
        "standard",
        "official_document",
        "personal_note",
        "unknown"
      ]
    }
  },
  "additionalProperties": false,
  "if": {
    "properties": {
      "status": {"const": "STOP"}
    }
  },
  "then": {
    "required": ["stop_reason"]
  }
}
