{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UPI Research Session",
  "type": "object",
  "required": ["format", "version", "items"],
  "properties": {
    "format": {"const": "upi-research-session"},
    "version": {"type": "string"},
    "session_id": {"type": "string"},
    "intent": {"type": "string"},
    "source": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "kind": {"type": "string"},
          "function": {},
          "links": {"type": "array", "items": {"type": "string"}},
          "record": {
            "type": "object",
            "properties": {
              "record_type": {"type": "string", "enum": ["node", "bridge"]},
              "payload": {"type": "object"}
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
