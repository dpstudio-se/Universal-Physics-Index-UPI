{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UPI Agent Workflow Specification",
  "type": "object",
  "required": [
    "workflow_id",
    "version",
    "status",
    "roles",
    "states",
    "transitions",
    "invariants",
    "governance",
    "confusion_guard"
  ],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"const": "SYM"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role_id", "agent_class", "default_deny", "capabilities"],
        "properties": {
          "role_id": {"type": "string", "minLength": 1},
          "agent_class": {
            "type": "string",
            "enum": [
              "manager",
              "specialist",
              "verifier",
              "coordinator",
              "transport",
              "reviewer",
              "repair",
              "quarantine"
            ]
          },
          "default_deny": {"const": true},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["QUEUED", "LEASED", "RUNNING", "SUCCEEDED", "FAILED", "TIMED_OUT", "QUARANTINED", "CANCELLED"]
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "condition"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "condition": {"type": "string", "minLength": 1},
          "independent_review": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "governance": {
      "type": "object",
      "required": [
        "owner",
        "state_model",
        "durable_artifact",
        "evidence_required",
        "retry_policy",
        "approval_boundary"
      ],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "state_model": {"type": "string", "minLength": 1},
        "durable_artifact": {"type": "string", "minLength": 1},
        "evidence_required": {"const": true},
        "retry_policy": {
          "type": "object",
          "required": ["max_attempts", "on_exhausted"],
          "properties": {
            "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
            "on_exhausted": {"type": "string", "enum": ["escalate", "quarantine", "cancel"]}
          },
          "additionalProperties": false
        },
        "approval_boundary": {
          "type": "object",
          "required": ["requires_approval_when", "approver"],
          "properties": {
            "requires_approval_when": {"type": "string", "minLength": 1},
            "approver": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "confusion_guard": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
