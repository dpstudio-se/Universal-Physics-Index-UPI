{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UPI Operational Skill",
  "type": "object",
  "required": [
    "skill_id",
    "version",
    "status",
    "objective",
    "activation",
    "steps",
    "examples",
    "anti_patterns",
    "acceptance_tests",
    "changelog"
  ],
  "properties": {
    "skill_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"const": "SYM"},
    "objective": {"type": "string", "minLength": 1},
    "activation": {
      "type": "object",
      "required": ["when", "not_when"],
      "properties": {
        "when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "not_when": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "examples": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "anti_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criterion", "verification_type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "criterion": {"type": "string", "minLength": 1},
          "verification_type": {"const": "software_test"}
        },
        "additionalProperties": false
      }
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "change"],
        "properties": {
          "version": {"type": "string", "minLength": 1},
          "change": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "confusion_guard": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
