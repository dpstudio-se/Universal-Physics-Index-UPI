# Live contribution store. Default is local SQLite.
UPI_DATABASE_URL=sqlite:///upi.db

# Shared maintainer credential. Empty disables EST promotion.
# Send as X-UPI-Review-Token; restart the server after changing it.
UPI_REVIEW_TOKEN=

# Remote PostgreSQL example:
# UPI_DATABASE_URL=postgresql://upi:upi@localhost:5432/upi
